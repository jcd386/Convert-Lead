    <formulas>
        <name>fStatusName</name>
        <dataType>String</dataType>
        <expression>IF({!Pick_Status} = "Auto-detect (recommended)", "", {!Pick_Status})</expression>
    </formulas>
    <formulas>
        <name>fAccountId</name>
        <dataType>String</dataType>
        <expression>IF({!Rad_Account} = "Use Existing Account", {!Lkp_Account.recordId}, "")</expression>
    </formulas>
    <formulas>
        <name>fContactId</name>
        <dataType>String</dataType>
        <expression>IF({!Rad_Contact} = "Use Existing Contact", {!Lkp_Contact.recordId}, "")</expression>
    </formulas>
    <formulas>
        <name>fOpportunityId</name>
        <dataType>String</dataType>
        <expression>IF({!Rad_Opp} = "Use Existing Opportunity", {!Lkp_Opp.recordId}, "")</expression>
    </formulas>
    <formulas>
        <name>fOppName</name>
        <dataType>String</dataType>
        <expression>IF({!Rad_Opp} = "Create New Opportunity", {!Inp_Opp_Name}, "")</expression>
    </formulas>
    <formulas>
        <name>fDoNotCreateOpp</name>
        <dataType>Boolean</dataType>
        <expression>{!Rad_Opp} = "Do Not Create an Opportunity"</expression>
    </formulas>
    <formulas>
        <name>fOwnerRaw</name>
        <dataType>String</dataType>
        <expression>IF({!Pick_Owner} = "Keep current Lead owner", "", {!Pick_Owner})</expression>
    </formulas>
    <formulas>
        <name>fOwnerNeedsLookup</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK({!fOwnerRaw})), NOT(BEGINS({!fOwnerRaw}, "005")))</expression>
    </formulas>
    <formulas>
        <name>fOwnerId</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!fOwnerRaw}), "", IF(BEGINS({!fOwnerRaw}, "005"), {!fOwnerRaw}, {!Get_Owner_User.Id}))</expression>
    </formulas>
